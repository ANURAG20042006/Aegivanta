# Multi-Stage Build for SentinelAI FastAPI Backend & ML Engine
FROM python:3.11-slim AS base

# Set Environment Variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

# Install System Build Dependencies & C Libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python Requirements
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy Backend, ML Engine, and Application Source Code
COPY backend /app/backend
COPY ml /app/ml

# Create Directories for Logs, Reports, and Artifacts
# Create non-root user for security
RUN addgroup --system --gid 10001 aegivanta && \
    adduser --system --uid 10001 --ingroup aegivanta aegivanta && \
    mkdir -p /app/logs /app/reports /app/ml/artifacts && \
    chown -R aegivanta:aegivanta /app

# Switch to non-root user
USER aegivanta

# Expose FastAPI Port
EXPOSE 8000

# Healthcheck Endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Command to run FastAPI server using Uvicorn
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
