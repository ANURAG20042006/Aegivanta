# Aegivanta — Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR PRIVATE KEYS TO VERSION CONTROL.
# Copy this file to .env and fill in real values for local development.
# In production, use environment variable injection (Docker Secrets / Kubernetes Secrets / CI secrets).

# =============================================================================
# GENERAL APPLICATION SETTINGS
# =============================================================================
APP_NAME="Aegivanta"
APP_ENV="development"         # Options: development | staging | production
OPERATING_MODE="DEMO"         # Options: DEMO | LAB | PRODUCTION
DEBUG=false
API_V1_STR="/api/v1"
PROJECT_VERSION="50.0.0"

# =============================================================================
# CRYPTOGRAPHIC AUTHENTICATION & JWT SECRETS
# MINIMUM 32 CHARACTERS IN PRODUCTION — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480    # 8 hours

# =============================================================================
# DATABASE CREDENTIALS
# In production use PostgreSQL — never SQLite
# =============================================================================
DATABASE_URL="sqlite+aiosqlite:///./sentinelai.db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="aegivanta_db_user"
POSTGRES_PASSWORD=
POSTGRES_DB="aegivanta_db"

# =============================================================================
# SEEDED USER PASSWORDS — MANDATORY ENVIRONMENT VARIABLES
# Primary: AEGIVANTA_* | Backward compatibility: SENTINEL_*
# =============================================================================
AEGIVANTA_ADMIN_PASSWORD=
AEGIVANTA_ANALYST_PASSWORD=
AEGIVANTA_VIEWER_PASSWORD=
# Legacy aliases (supported for backward compatibility):
SENTINEL_ADMIN_PASSWORD=
SENTINEL_ANALYST_PASSWORD=
SENTINEL_VIEWER_PASSWORD=

# =============================================================================
# REDIS CACHE & MESSAGE BROKER SETTINGS
# =============================================================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
STREAM_TELEMETRY_KEY="aegivanta:telemetry"
STREAM_CONSUMER_GROUP="aegivanta:telemetry:group"
STREAM_DLQ_KEY="aegivanta:telemetry:dlq"
STREAM_PUBSUB_CHANNEL="aegivanta:events"

# =============================================================================
# CORS — restrict to specific frontend origins in production
# Never use "*" wildcard in production
# =============================================================================
CORS_ORIGINS=["https://aegivanta.io","http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# =============================================================================
# ML ENGINE & ARTIFACT PATHING
# =============================================================================
MODEL_ARTIFACTS_DIR="ml/artifacts"
DEFAULT_MODEL_NAME="Random Forest"
BATCH_SIZE=128
SHAP_EXPLAINER_BACKGROUND_SAMPLES=100

# =============================================================================
# LOGGING & AUDIT CONFIGURATION
# =============================================================================
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/aegivanta.log"
