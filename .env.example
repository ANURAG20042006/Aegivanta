# SentinelAI Security Architecture & Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR PRIVATE KEYS TO VERSION CONTROL.

# General App Settings
APP_NAME="SentinelAI"
APP_ENV="development" # Options: development, staging, production
OPERATING_MODE="DEMO" # Options: DEMO, LAB, PRODUCTION
DEBUG=false
API_V1_STR="/api/v1"
PROJECT_VERSION="1.0.0"

# Cryptographic Authentication & JWT Secrets (MINIMUM 32 CHARACTERS IN PRODUCTION)
SECRET_KEY="generate_high_entropy_random_32_character_secret_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480 # 8 Hours

# Database Credentials
DATABASE_URL="sqlite+aiosqlite:///./sentinelai.db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="sentinel_db_user"
POSTGRES_PASSWORD="change_me_to_strong_db_password"
POSTGRES_DB="sentinelai_db"

# Redis Cache & Message Broker Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# CORS Security Allowed Origins (Comma-separated list in production)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ML Engine & Artifact Pathing
MODEL_ARTIFACTS_DIR="ml/artifacts"
DEFAULT_MODEL_NAME="Random Forest"
BATCH_SIZE=128
SHAP_EXPLAINER_BACKGROUND_SAMPLES=100

# Logging & Audit Configuration
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/sentinelai.log"
