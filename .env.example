# SentinelAI environment configuration
# Copy this file to .env and replace every value marked CHANGE_ME before production.

# Application
APP_NAME=SentinelAI
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
# Required: use a unique value of at least 32 characters in production.
SECRET_KEY=CHANGE_ME_USE_A_UNIQUE_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Development database (works without PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./sentinelai.db

# Production database example
# DATABASE_URL=postgresql+asyncpg://sentinel_user:CHANGE_ME@db-host:5432/sentinelai

# Browser origins allowed to call the API. Use your real domain in production.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional service endpoints
REDIS_URL=redis://localhost:6379/0
MODEL_ARTIFACTS_DIR=ml/artifacts
DEFAULT_MODEL_NAME=Random Forest
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/sentinelai.log
